class StudentController {

    public function __construct() {

        add_shortcode('student_create',[$this,'create_form']);
        add_shortcode('student_list',[$this,'list']);
        add_shortcode('student_edit',[$this,'edit']);

        add_action('admin_post_save_student', [$this,'store']);
        add_action('admin_post_update_student', [$this,'update']);
        add_action('init',[$this,'delete']);
    }

    public function create_form() {
        include plugin_dir_path(__FILE__).'../views/create.php';
    }

    public function list() 
    {
        ////pagination////
        $paged = isset($_GET['pg']) ? intval($_GET['pg']) : 1;
        $limit = 5;
         $offset = ($paged - 1) * $limit;
     
        $model = new StudentModel();
        $students = $model->get_all($limit,$offset);

        $total = $model->total_students();
        $total_pages = ceil($total / $limit);

        include plugin_dir_path(__FILE__).'../views/list.php';
    }

    public function store() 
    {

        if(isset($_POST['save_student'])) 
        {

            if(!wp_verify_nonce($_POST['_wpnonce'],'save_student_nonce')) 
            {
                return;
            }

            $image_url = '';

            if(!empty($_FILES['student_image']['name']))
            {
	$filetype = wp_check_filetype($_FILES['student_image']['name']);
    	$allowed = ['jpg','jpeg','png','webp'];

    	if(!in_array($filetype['ext'],$allowed)){
        		return;
    	}

	require_once(ABSPATH.'wp-admin/includes/file.php');

	$uploaded = wp_handle_upload(
	$_FILES['student_image'],
	['test_form'=>false]
	);

	if(isset($uploaded['url'])){
	     $image_url = $uploaded['url'];   //image upload in wp-content/uploads
	}

            }

            $model = new StudentModel();

            $data = [

                'name'  => sanitize_text_field($_POST['name']),
                'email' => sanitize_email($_POST['email']),
                'phone' => sanitize_text_field($_POST['phone']),
	'image' => $image_url
            ];

            $model->insert($data);

	wp_redirect(home_url('/student-list'));
         	exit;
        }
         
    }

     public function edit() 
     {

        if(!isset($_GET['id'])) return;

        $id = intval($_GET['id']);

        $model = new StudentModel();

        $student = $model->find($id);

        include plugin_dir_path(__FILE__) . '../views/edit.php';
    }

     public function update()
     {
	if(isset($_POST['update_student'])){

	if(!wp_verify_nonce($_POST['_wpnonce'],'update_student_nonce')){
		return;
	}

                $image_url = '';

                if(!empty($_FILES['student_image']['name'])){

		require_once(ABSPATH.'wp-admin/includes/file.php');

		$uploaded = wp_handle_upload(
		$_FILES['student_image'],
		['test_form'=>false]
		);

                	if(isset($uploaded['url'])){
    			$image_url = $uploaded['url'];
                	}

                 }

	$id = intval($_POST['id']);

	$data = [

		'name'  => sanitize_text_field($_POST['name']),
		'email' => sanitize_email($_POST['email']),
		'phone' => sanitize_text_field($_POST['phone'])

	];

                if($image_url){
		$data['image']=$image_url;
                }

	$model = new StudentModel();

	$model->update($id,$data);

	wp_redirect(home_url('/student-list'));
	exit;
	}
	
     }

     public function delete(){

	if(isset($_GET['action']) && $_GET['action']=='delete_student'){

	if(!isset($_GET['nonce']) || !wp_verify_nonce($_GET['nonce'],'delete_student_nonce')){
		return;
	}

	$id = intval($_GET['id']);

	$model = new StudentModel();

	$student = $model->find($id);

	if(!$student){
    	    return;
	}

	$upload_dir = wp_upload_dir();
	$file_path = str_replace($upload_dir['baseurl'], $upload_dir['basedir'], $student->image);

	if(file_exists($file_path)){
		unlink($file_path);
	}

	$model->delete($id);
	
	wp_redirect(home_url('/student-list'));
   	exit;
      	}
	
     }


}


